# React SPA — this folder is mapped as the domain root by Strato, so the app
# is served from "/". The build emits root-absolute asset URLs (/static/...).
#
# NOTE: on upload this replaces the .htaccess in the target folder. If you keep
# extra server rules there (force-HTTPS, hotlink protection, etc.), merge them in.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files/directories (JS, CSS, images, fonts) as-is...
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # ...everything else falls through to the SPA entry point so client-side
  # routes (e.g. /resources) survive a hard refresh.
  RewriteRule . /index.html [L]
</IfModule>

# Cache the content-hashed build assets aggressively; never cache the HTML
# shell, so a redeploy is picked up immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
